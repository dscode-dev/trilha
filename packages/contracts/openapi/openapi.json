              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Read one place",
        "tags": [
          "places"
        ]
      }
    },
    "/api/v1/places": {
      "post": {
        "description": "Requires a session. Provenance, status and authorship are decided by the server and ignored if sent. The response may carry advisory near-duplicates.",
        "operationId": "PlacesController_create",
        "parameters": [],
