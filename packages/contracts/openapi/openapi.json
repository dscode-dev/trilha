                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Contribute a place",
        "tags": [
          "places"
        ]
      }
    },
    "/api/v1/routes/calculate": {
      "post": {
        "description": "Returns a normalised route between two points: GeoJSON geometry, distance in metres, duration in seconds, bounds computed from the geometry, and legs. Driving only in V1. Nothing is persisted — a route is a computation, not a record.",
        "operationId": "RoutesController_calculate",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculateRouteRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid coordinates, or endpoints too close together or too far apart.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "No driving route connects the two points.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "The routing provider is unavailable or returned an unusable result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "The routing provider exceeded its deadline.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Calculate a driving route",
        "tags": [
          "routing"
        ]
      }
    }
  },
  "info": {
    "title": "Trilha API",
    "description": "Trilha platform API. PR-00 exposes platform endpoints only; product domains are introduced by their own pull requests.",
    "version": "0.0.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "platform",
      "description": "Liveness, readiness and other operational endpoints"
    }
  ],
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "trilha-api"
          },
          "environment": {
            "type": "string",
            "example": "development"
          },
          "uptimeSeconds": {
            "type": "number",
            "description": "Process uptime in seconds.",
            "example": 12.34
          },
          "timestamp": {
            "type": "string",
            "example": "2026-09-04T12:00:00.000Z"
          }
        },
        "required": [
          "status",
          "service",
          "environment",
          "uptimeSeconds",
          "timestamp"
        ]
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready",
              "not_ready"
            ],
            "example": "ready"
          },
          "service": {
            "type": "string",
            "example": "trilha-api"
          },
          "timestamp": {
            "type": "string",
            "example": "2026-09-04T12:00:00.000Z"
          },
          "dependencies": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            },
            "description": "Per-dependency probe results."
          }
        },
        "required": [
          "status",
          "service",
          "timestamp",
          "dependencies"
        ]
      },
      "DeviceDto": {
        "type": "object",
        "properties": {
          "deviceName": {
            "type": "string",
            "example": "Pixel 8",
            "maxLength": 80
          },
          "platform": {
            "enum": [
              "ios",
              "android",
              "web"
            ],
            "type": "string"
          },
          "appVersion": {
            "type": "string",
            "example": "0.1.0",
            "maxLength": 40
          }
        }
      },
      "RegisterRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128,
            "description": "At least 12 characters. Passphrases are encouraged.",
            "example": "a quiet trail through pine"
          },
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "description": "Letters and numbers, optionally separated by a single - or _.",
            "example": "ana-souza"
          },
          "displayName": {
            "type": "string",
            "maxLength": 80,
            "example": "Ana Souza"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceDto"
          }
        },
        "required": [
          "email",
          "password",
          "username",
          "displayName"
        ]
      },
      "AuthTokensDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived bearer token for the Authorization header."
          },
          "refreshToken": {
            "type": "string",
            "description": "Opaque, single-use token. Rotated on every refresh; the previous value is invalidated and replaying it revokes the session."
          },
          "expiresIn": {
            "type": "number",
            "example": 600,
            "description": "Seconds until the access token expires."
          },
          "tokenType": {
            "type": "string",
            "example": "Bearer"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresIn",
          "tokenType"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "BAD_REQUEST",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "UNSUPPORTED_MEDIA_TYPE",
              "TOO_MANY_REQUESTS",
              "INVALID_CREDENTIALS",
              "EMAIL_ALREADY_IN_USE",
              "USERNAME_ALREADY_IN_USE",
              "WEAK_PASSWORD",
              "INVALID_TOKEN",
              "SESSION_EXPIRED",
              "ACCOUNT_DISABLED",
              "ROUTE_NOT_FOUND",
              "INVALID_ROUTE_REQUEST",
              "PROVIDER_TIMEOUT",
              "PROVIDER_UNAVAILABLE",
              "PROVIDER_RATE_LIMITED",
              "INTERNAL_ERROR",
              "SERVICE_UNAVAILABLE",
              "DEPENDENCY_UNAVAILABLE"
            ],
            "description": "Stable machine-readable code. Safe for clients to branch on.",
            "example": "NOT_FOUND"
          },
          "message": {
            "type": "string",
            "description": "Human-readable summary. Not intended for end-user display verbatim.",
            "example": "Resource not found"
          },
          "requestId": {
            "type": "string",
            "description": "Correlation id for this request. Quote it when reporting problems.",
            "example": "018f4c9e-2a1b-7c3d-9e4f-5a6b7c8d9e0f"
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional structured context. Never contains internal details."
          }
        },
        "required": [
          "code",
          "message",
          "requestId"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ]
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana@example.com"
          },
          "password": {
            "type": "string",
            "description": "The account password.",
            "example": "a quiet trail through pine"
          },
          "device": {
            "$ref": "#/components/schemas/DeviceDto"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshRequestDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The opaque refresh token from the previous authentication response."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "LogoutAllResponseDto": {
        "type": "object",
        "properties": {
          "revokedCount": {
            "type": "number",
            "example": 3
          }
        },
        "required": [
          "revokedCount"
        ]
      },
      "ProfileDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "ana-souza"
          },
          "displayName": {
            "type": "string",
            "example": "Ana Souza"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true,
            "description": "Always null in V1 — avatar upload is not implemented yet.",
            "example": null
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 280,
            "example": null
          }
        },
        "required": [
          "username",
          "displayName",
          "avatarUrl",
          "bio"
        ]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "01a06cc8-9b3a-7ba0-879e-f01610559f9c"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana@example.com"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "DISABLED",
              "PENDING"
            ],
            "example": "ACTIVE"
          },
          "profile": {
            "$ref": "#/components/schemas/ProfileDto"
          }
        },
        "required": [
          "id",
          "email",
          "status",
          "profile"
        ]
      },
      "UpdateProfileRequestDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30,
            "example": "ana-souza"
          },
          "displayName": {
            "type": "string",
            "maxLength": 80,
            "example": "Ana Souza"
          },
          "bio": {
            "type": "string",
            "nullable": true,
            "maxLength": 280,
            "description": "Send null to clear it."
          }
        }
      },
      "ChangePasswordRequestDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "description": "The password currently on the account."
          },
          "newPassword": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "ChangePasswordResponseDto": {
        "type": "object",
        "properties": {
          "revokedSessions": {
            "type": "number",
            "example": 2,
            "description": "Sessions revoked by this change. Every session is revoked, including the caller’s, so the client must sign in again."
          }
        },
        "required": [
          "revokedSessions"
        ]
      },
      "PlaceCategoryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "FOOD"
          },
          "label": {
            "type": "string",
            "example": "Food & drink"
          }
        },
        "required": [
          "id",
          "label"
        ]
      },
      "PlaceMapItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Marco Zero"
          },
          "categoryId": {
            "type": "string",
            "example": "LANDMARK"
          },
          "latitude": {
            "type": "number",
            "example": -8.0631
          },
          "longitude": {
            "type": "number",
            "example": -34.8711
          }
        },
        "required": [
          "id",
          "name",
          "categoryId",
          "latitude",
          "longitude"
        ]
      },
      "PlaceMapResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaceMapItemDto"
            }
          },
          "truncated": {
            "type": "boolean",
            "example": false,
            "description": "True when the viewport held more places than the response cap. Zoom in."
          }
        },
        "required": [
          "items",
          "truncated"
        ]
      },
      "PlaceListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Marco Zero"
          },
          "categoryId": {
            "type": "string",
            "example": "LANDMARK"
          },
          "latitude": {
            "type": "number",
            "example": -8.0631
          },
          "longitude": {
            "type": "number",
            "example": -34.8711
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "distanceMetres": {
            "type": "number",
            "nullable": true,
            "description": "Metres from the query point. Null when the query had no reference point.",
            "example": 850
          }
        },
        "required": [
          "id",
          "name",
          "categoryId",
          "latitude",
          "longitude",
          "description",
          "distanceMetres"
        ]
      },
      "PlacePageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaceListItemDto"
            }
          },
          "limit": {
            "type": "number",
            "example": 20
          },
          "offset": {
            "type": "number",
            "example": 0
          },
          "hasMore": {
            "type": "boolean",
            "example": false
          }
        },
        "required": [
          "items",
          "limit",
          "offset",
          "hasMore"
        ]
      },
      "PlaceContributorDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "example": "ana-souza"
          },
          "displayName": {
            "type": "string",
            "example": "Ana Souza"
          }
        },
        "required": [
          "username",
          "displayName"
        ]
      },
      "PlaceDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "example": "Marco Zero"
          },
          "categoryId": {
            "type": "string",
            "example": "LANDMARK"
          },
          "latitude": {
            "type": "number",
            "example": -8.0631
          },
          "longitude": {
            "type": "number",
            "example": -34.8711
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "provenance": {
            "type": "string",
            "enum": [
              "COMMUNITY",
              "SYSTEM"
            ],
            "description": "Where this record came from.",
            "example": "COMMUNITY"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "PENDING_REVIEW",
              "ARCHIVED"
            ],
            "example": "ACTIVE"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-09-04T12:00:00.000Z"
          },
          "updatedAt": {
            "type": "string",
            "example": "2026-09-04T12:00:00.000Z"
          },
          "contributor": {
            "nullable": true,
            "description": "Public attribution for a community submission. Never an email or account id.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/PlaceContributorDto"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "categoryId",
          "latitude",
          "longitude",
          "description",
          "provenance",
          "status",
          "createdAt",
          "updatedAt",
          "contributor"
        ]
      },
      "CreatePlaceRequestDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 120,
            "example": "Marco Zero"
          },
          "categoryId": {
            "type": "string",
            "example": "LANDMARK",
            "description": "An id from GET /places/categories."
          },
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "example": -8.0631
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "example": -34.8711
          },
          "description": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000
          }
        },
        "required": [
          "name",
          "categoryId",
          "latitude",
          "longitude"
        ]
      },
      "CreatePlaceResponseDto": {
        "type": "object",
        "properties": {
          "place": {
            "$ref": "#/components/schemas/PlaceDetailDto"
          },
          "possibleDuplicates": {
            "description": "Nearby places with a similar name and the same category. Advisory only — the submission was accepted. Two restaurants sharing a name in different places are not duplicates.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PlaceListItemDto"
            }
          }
        },
        "required": [
          "place",
          "possibleDuplicates"
        ]
      },
      "RouteEndpointDto": {
        "type": "object",
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "example": -8.0631
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "example": -34.8711
          },
          "placeId": {
            "type": "string",
            "format": "uuid",
            "description": "Set when this endpoint came from a Place. Routing never requires one."
          }
        },
        "required": [
          "latitude",
          "longitude"
        ]
      },
      "CalculateRouteRequestDto": {
        "type": "object",
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/RouteEndpointDto"
          },
          "destination": {
            "$ref": "#/components/schemas/RouteEndpointDto"
          },
          "corridorWidthMeters": {
            "type": "number",
            "minimum": 100,
            "maximum": 50000,
            "description": "Corridor half-width in metres. Clamped to the server maximum.",
            "example": 5000
          },
          "includeCorridor": {
            "type": "boolean",
            "default": false,
            "description": "Return the corridor polygon. Off by default: it is a large geometry that clients do not draw."
          }
        },
        "required": [
          "origin",
          "destination"
        ]
      },
      "RouteGeometryDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "LineString"
            ],
            "example": "LineString"
          },
          "coordinates": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "description": "GeoJSON positions as [longitude, latitude] — GeoJSON axis order.",
            "example": [
              [
                -34.8711,
                -8.0631
              ],
              [
                -34.8631,
                -7.115
              ]
            ]
          }
        },
        "required": [
          "type",
          "coordinates"
        ]
      },
      "RouteBoundsDto": {
        "type": "object",
        "properties": {
          "north": {
            "type": "number",
            "example": -7.115
          },
          "south": {
            "type": "number",
            "example": -8.0631
          },
          "east": {
            "type": "number",
            "example": -34.8631
          },
          "west": {
            "type": "number",
            "example": -34.8711
          }
        },
        "required": [
          "north",
          "south",
          "east",
          "west"
        ]
      },
      "RouteLegDto": {
        "type": "object",
        "properties": {
          "distanceMeters": {
            "type": "number",
            "example": 105060
          },
          "durationSeconds": {
            "type": "number",
            "example": 6480
          },
          "summary": {
            "type": "string",
            "nullable": true,
            "example": "BR-101"
          }
        },
        "required": [
          "distanceMeters",
          "durationSeconds",
          "summary"
        ]
      },
      "RouteCorridorDto": {
        "type": "object",
        "properties": {
          "widthMeters": {
            "type": "number",
            "example": 5000
          },
          "geometry": {
            "type": "object",
            "additionalProperties": true,
            "description": "GeoJSON Polygon or MultiPolygon covering the area around the route."
          }
        },
        "required": [
          "widthMeters",
          "geometry"
        ]
      },
      "RouteResponseDto": {
        "type": "object",
        "properties": {
          "origin": {
            "$ref": "#/components/schemas/RouteEndpointDto"
          },
          "destination": {
            "$ref": "#/components/schemas/RouteEndpointDto"
          },
          "geometry": {
            "$ref": "#/components/schemas/RouteGeometryDto"
          },
          "distanceMeters": {
            "type": "number",
            "example": 105060,
            "description": "Road distance in metres."
          },
          "durationSeconds": {
            "type": "number",
            "example": 6480,
            "description": "Estimated driving time in seconds."
          },
          "bounds": {
            "$ref": "#/components/schemas/RouteBoundsDto"
          },
          "legs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RouteLegDto"
            }
          },
          "corridor": {
            "nullable": true,
            "description": "Present only when includeCorridor was requested.",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/RouteCorridorDto"
              }
            ]
          }
        },
        "required": [
          "origin",
          "destination",
          "geometry",
          "distanceMeters",
          "durationSeconds",
          "bounds",
          "legs",
          "corridor"
        ]
      }
    }
  }
}
