              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Change the account password",
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/places/categories": {
      "get": {
        "description": "The fixed vocabulary a place can be filed under. Public.",
        "operationId": "PlacesController_categories",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PlaceCategoryDto"
                  }
                }
              }
            }
          }
        },
        "summary": "List place categories",
        "tags": [
          "places"
        ]
      }
    },
    "/api/v1/places/map": {
      "get": {
        "description": "The map query. Returns only what a marker needs — id, name, category and position — so a pan does not transfer descriptions nobody is reading. Viewports crossing the antimeridian are rejected; see the error message.",
        "operationId": "PlacesController_map",
        "parameters": [
          {
            "name": "west",
            "required": true,
            "in": "query",
            "schema": {
              "example": -34.9
            }
          },
          {
            "name": "east",
            "required": true,
            "in": "query",
            "schema": {
              "example": -34.8
            }
          },
          {
            "name": "south",
            "required": true,
            "in": "query",
            "schema": {
              "example": -8.1
            }
          },
          {
            "name": "north",
            "required": true,
            "in": "query",
            "schema": {
              "example": -8
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlaceMapResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Places inside a viewport",
        "tags": [
          "places"
        ]
      }
    },
    "/api/v1/places/nearby": {
      "get": {
        "description": "Nearest first. Distances are metres on the spheroid, not degrees.",
        "operationId": "PlacesController_nearby",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlacePageDto"
                }
              }
            }
          },
          "400": {
