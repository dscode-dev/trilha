                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Search places by name",
        "tags": [
          "places"
        ]
      }
    },
    "/api/v1/places/{id}": {
      "get": {
        "description": "Public. Archived places are hidden.",
        "operationId": "PlacesController_byId",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
