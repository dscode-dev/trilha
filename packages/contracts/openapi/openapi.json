                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Places within a radius",
        "tags": [
          "places"
        ]
      }
    },
    "/api/v1/places/search": {
      "get": {
        "description": "Accent- and case-insensitive: \"sao paulo\" matches \"São Paulo\". Supply lat/lng to order results by proximity and receive distances.",
        "operationId": "PlacesController_search",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
