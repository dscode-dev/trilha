# Trilha API — environment template
# Copy to `.env` and adjust. NEVER commit a real `.env` (see .gitignore).
# Every variable below is validated at startup by src/infrastructure/config/env.schema.ts;
# the process refuses to boot if this file is wrong.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3000
APP_NAME=trilha-api

# --- HTTP ------------------------------------------------------------------
# Comma-separated origins. "*" is accepted in development only; production
# startup fails if it is left wide open.
CORS_ORIGINS=http://localhost:3000
HTTP_BODY_LIMIT=1mb

# --- PostgreSQL ------------------------------------------------------------
# Matches the credentials in infra/local/docker-compose.yml.
DATABASE_URL=postgresql://trilha:trilha@localhost:5432/trilha
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_SSL=false

# --- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_COMMAND_TIMEOUT_MS=2000

# --- Authentication --------------------------------------------------------
# Generate real values before running anything beyond local development:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# The placeholders below are REJECTED at startup when NODE_ENV=production, so a
# deployment that copies this file unedited fails loudly instead of shipping a
# forgeable token secret.
JWT_ACCESS_SECRET=development-only-insecure-secret-value-replace-me
JWT_ISSUER=trilha-api
JWT_AUDIENCE=trilha-mobile

# Access token lifetime. Short on purpose: logout revokes the session immediately,
# and an already-issued access token stops working when it expires.
JWT_ACCESS_TTL_SECONDS=600
# Refresh token / session lifetime. 30 days.
REFRESH_TTL_SECONDS=2592000

# Key for the one-way digest of client IPs in audit records. Must differ from
# JWT_ACCESS_SECRET; raw addresses are never stored.
IP_HASH_KEY=development-only-insecure-secret-value-for-ip-hashing

# --- Auth rate limiting (per window, per bucket) ---------------------------
RATE_LIMIT_WINDOW_SECONDS=900
RATE_LIMIT_LOGIN_PER_IP=30
RATE_LIMIT_LOGIN_PER_ACCOUNT=10
RATE_LIMIT_REGISTER_PER_IP=10
RATE_LIMIT_REFRESH_PER_IP=60
RATE_LIMIT_PASSWORD_PER_USER=10

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=debug
# Human-readable logs. Must be false outside development.
LOG_PRETTY=true

# --- API documentation -----------------------------------------------------
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# --- Observability (optional; unset = disabled) ----------------------------
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_SERVICE_NAME=trilha-api
